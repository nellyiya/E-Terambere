# Copy this file to .env and fill it in. Never commit .env or share it.
# If the password has special characters (@ : / #), URL-encode them.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/E-terambere_db

# Secret used to sign sign-in tokens. REQUIRED (at least 32 characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional: how long a sign-in lasts without activity (minutes). Default 60.
ACCESS_TOKEN_MINUTES=60

# Optional: how long an email is locked after 5 wrong sign-in attempts (seconds, minimum 30). Default 60.
LOGIN_LOCKOUT_SECONDS=60
